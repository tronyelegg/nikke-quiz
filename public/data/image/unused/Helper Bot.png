}
</style></head><body><link rel="preload" href="/eyes.webp"><link rel="preload" href="/common/bg.png"><div data-astro-transition-persist="astro-xqnp5chy-1" id="wtf-did-you-guys-see-that" data-astro-cid-l7arcky5></div><div data-astro-transition-persist="astro-ic55ljvk-2" id="shooting-stars" data-astro-cid-l7arcky5><span class="shooting-star" data-astro-cid-l7arcky5></span><span class="shooting-star" data-astro-cid-l7arcky5></span><span class="shooting-star" data-astro-cid-l7arcky5></span><span class="shooting-star" data-astro-cid-l7arcky5></span><span class="shooting-star" data-astro-cid-l7arcky5></span><span class="shooting-star" data-astro-cid-l7arcky5></span><span class="shooting-star" data-astro-cid-l7arcky5></span><span class="shooting-star" data-astro-cid-l7arcky5></span><span class="shooting-star" data-astro-cid-l7arcky5></span><span class="shooting-star" data-astro-cid-l7arcky5></span></div><div data-astro-transition-persist="astro-efc7yfzl-3" id="loading-bar" data-astro-cid-l7arcky5></div><div data-astro-transition-persist="astro-ja5w7jm3-4" class="navbar" data-astro-cid-l7arcky5><div class="navbar-inner" data-astro-cid-l7arcky5><div class="navbar-list" data-astro-cid-l7arcky5><a href="/" class="logo" data-astro-cid-l7arcky5><img src="/common/nkas.png" alt="NKAS logo" data-astro-cid-l7arcky5> <span data-astro-cid-l7arcky5>NKAS</span></a></div><div class="navbar-anis" data-astro-cid-l7arcky5><img src="/update_anis.gif" alt="Update Anis" draggable="false" title="Click me!" id="update-anis" data-astro-cid-l7arcky5></div><div class="navbar-list" data-astro-cid-l7arcky5><a href="/" data-astro-cid-l7arcky5>Home</a><a href="/feedback/" data-astro-cid-l7arcky5>Feedback</a><i class="fa-solid fa-star extra" id="toggle-stars" data-astro-cid-l7arcky5></i><!-- <a href="https://skuqre.itch.io/ultimate-scenario-creator" class="extra"><img src="/common/usc.svg" alt="USC"></a> --></div></div></div><script type="module">//#region src/components/Navbar.astro?astro&type=script&index=0&lang.ts
var bar = document.getElementById("loading-bar");
document.addEventListener("astro:before-preparation", (event) => {
	bar.style.width = "0%";
	bar.classList.add("active");
	bar.classList.remove("done");
	const originalLoader = event.loader;
	event.loader = async () => {
		bar.style.width = "30%";
		await originalLoader();
		bar.style.width = "90%";
	};
});
document.addEventListener("astro:after-swap", () => {
	bar.style.width = "100%";
});
document.addEventListener("astro:page-load", () => {
	bar.classList.add("done");
	setTimeout(() => {
		bar.classList.remove("active");
		bar.style.width = "0%";
	}, 500);
});
async function theEntireScript() {
	const shootingStars = document.getElementById("shooting-stars");
	const starsToggle = document.getElementById("toggle-stars");
	const wtf = document.getElementById("wtf-did-you-guys-see-that");
	if (window.skelTimeout) {
		wtf.style.backgroundImage = null;
		clearInterval(window.skelTimeout);
		window.skelTimeout = null;
	}
	window.skelTimeout = setInterval(() => {
		if (Math.random() < .1) wtf.style.backgroundImage = "url('/eyes.webp#t=" + Date.now() + "')";
		wtf.offsetLeft;
		setTimeout(() => {
			wtf.style.backgroundImage = null;
		}, 780);
	}, 8780);
	if (localStorage.getItem("stars") !== null) {
		if (localStorage.getItem("stars") === "yes") shootingStars.style.display = null;
		else shootingStars.style.display = "none";
	} else localStorage.setItem("stars", "yes");
	starsToggle.className = `fa-${localStorage.getItem("stars") === "yes" ? "solid" : "regular"} fa-star extra`;
	starsToggle.onclick = () => {
		if (localStorage.getItem("stars") !== null) {
			if (localStorage.getItem("stars") === "yes") localStorage.setItem("stars", "no");
			else localStorage.setItem("stars", "yes");
		} else localStorage.setItem("stars", "yes");
		starsToggle.className = `fa-${localStorage.getItem("stars") === "yes" ? "solid" : "regular"} fa-star extra`;
		shootingStars.style.display = localStorage.getItem("stars") === "yes" ? null : "none";
	};
	const mainPageData = await (await fetch(`/site_data/main_page_data.json`)).json();
	const updateAnis = document.getElementById("update-anis");
	updateAnis.onclick = () => {
		const div = document.createElement("div");
		div.classList.add("update-anis-bubble");
		const name = document.createElement("span");
		name.classList.add("name");
		name.textContent = `Anis`;
		const text = document.createElement("span");
		text.classList.add("text");
		text.textContent = mainPageData.ver.anisSays;
		div.appendChild(name);
		div.appendChild(text);
		div.style.top = window.innerHeight * .25 + Math.random() * window.innerHeight * .5 + "px";
		div.style.left = window.innerWidth * .25 + Math.random() * window.innerWidth * .5 + "px";
		document.body.appendChild(div);
		setTimeout(() => {
			div.remove();
		}, 2100);
	};
}
document.addEventListener("astro:page-load", theEntireScript);
//#endregion</script><div class="content e-enter"><h1 style="text-align: center; margin-bottom: 0; text-shadow: 0 0 16px black;">Welcome to NKAS: 🎃 SPOOKY 🎃 edition!</h1><p class="sub-text">you're running on NKAS master@<code>f44657</code><br>dp@<code>6abb5d0</code> &bullet; core@<code>152.8.p23</code> &bullet; static@<code>571447</code><br><b>last updated <span id="build-date"></span></b></p><div class="generic-grid"><a href="/nikkes/" class="button-link"><div class="hero-button custom"><img src="/common/ui/icn_nikke.png"><div class="hero-button-content"><b>Nikkes</b><span>Nikkes and their skills.</span></div></div></a><a href="/bestiary/" class="button-link"><div class="hero-button custom"><img src="/common/ui/icn_boss.png"><div class="hero-button-content"><b>Bestiary</b><span>Raptures and their abilities.</span></div></div></a><a href="/battlefield-info/" class="button-link"><div class="hero-button"><i class="fa-solid fa-flag"></i><div class="hero-button-content"><b>Battlefield Info</b><span>Campaign and Tower stages.</span></div></div></a><a href="/jukebox/" class="button-link"><div class="hero-button"><i class="fa-solid fa-music"></i><div class="hero-button-content"><b>Jukebox</b><span>Wanna listen to some tunes?</span></div></div></a><a href="/viewer/" class="button-link"><div class="hero-button"><i class="fa-solid fa-person"></i><div class="hero-button-content"><b>Viewer</b><span>Inspect characters for details.</span></div></div></a><a href="/gallery/" class="button-link"><div class="hero-button"><i class="fa-solid fa-images"></i><div class="hero-button-content"><b>Gallery</b><span>View CGs from cutscenes.</span></div></div></a><a href="/advise/" class="button-link"><div class="hero-button"><i class="fa-solid fa-heart"></i><div class="hero-button-content"><b>Advise</b><span>Good answers and outcomes.</span></div></div></a><a href="/chibi/" class="button-link"><div class="hero-button"><i class="fa-solid fa-person smaller"></i><div class="hero-button-content"><b>Chibi Viewer</b><span>Inspect chibi characters.</span></div></div></a><a href="/data/" class="button-link"><div class="hero-button"><i class="fa-solid fa-database"></i><div class="hero-button-content"><b>Data</b><span>Use NKAS for your projects!</span></div></div></a><a href="/feedback/" class="button-link"><div class="hero-button"><i class="fa-solid fa-comment-dots"></i><div class="hero-button-content"><b>Feedback</b><span>Make NKAS better!</span></div></div></a></div><br><div class="info-card circle-question" data-astro-cid-akds2wd5><i class="fa-solid fa-circle-question" data-astro-cid-akds2wd5></i><span data-astro-cid-akds2wd5><b>You may be wondering why asset updates have been slower. </b>I can't quite promise patch-by-the-hour updates right now since my schedule has me on a chokehold. However, I can assure you updates can occur around the same day or a couple of days after. I apologize for the inconvenience, and to the people who visit NKAS when patches are up, expecting an update.</span></div><h2 style="text-align: center; line-height: 0.8; text-shadow: 0 0 16px black;">Other tools I've made<br><span class="other">and shilling here now (just because)</span></h2><div class="generic-grid twofer"><a href="https://skuqre.github.io/nikke-font-generator/" class="button-link"><div class="hero-button custom"><img src="/common/nfg.png"><div class="hero-button-content"><b>NIKKE Font Generator</b><span>Create fake screenshots with NIKKE interfaces.</span></div></div></a><a href="https://skuqre.itch.io/ultimate-scenario-creator/" class="button-link"><div class="hero-button custom"><img src="/common/usc.svg"><div class="hero-button-content"><b>Ultimate Scenario Creator</b><span>A comprehensive NIKKE Visual Novel engine.</span></div></div></a></div><div class="text-content" style="text-align: center; animation-delay: 0.05s;"><h2>Update Log</h2><br><div class="update-log">
    <div class="update-entry">
    <p class="update-date">10-13-2026</p>
    <div class="update-content"><ul>
<li><p><a href="/nk_data/colors.json"><code>colors.json</code></a> has been updated to be from direct game data. Now includes skin colors as well. Uses primary color (see colors_comp.json)</p>
</li>
<li><p><a href="/nk_data/colors_comp.json"><code>colors_comp.json</code></a> has been added as well, which provides primary (<code>pr</code>), secondary (<code>sc</code>), and view mode (<code>vm</code>) stripe colors. Uses resource IDs for keys instead of names.</p>
</li>
<li><p>Will add NPCs as well if demand is enough.</p>
</li>
<li><p>Added an Anis that, when clicked, displays what the latest currently added thing there is.</p>
</li>
</ul>
</div>
    </div>
    
    <div class="update-entry">
    <p class="update-date">10-12-2026</p>
    <div class="update-content"><p><strong>Chibi Viewer (ALPHA)</strong></p>
<p>Added the <a href="/chibi/">Chibi Viewer</a>!</p>
<p>This viewer is massively in an alpha state, so please report bugs and inconsistencies on the <a href="/feedback/">Feedback</a> form or through <a href="https://github.com/skuqre/nkas-issues/issues/new?template=1-bug.yaml">nkas-issues on GitHub</a>!</p>
</div>
    </div>
    
    <div class="update-entry">
    <p class="update-date">10-08-2026</p>
    <div class="update-content"><p>wtf did you guys see that 👀</p>
</div>
    </div>
    
    <div class="update-entry">
    <p class="update-date">10-06-2026</p>
    <div class="update-content"><p><strong>Viewer</strong></p>
<ul>
<li><p>Added realtime bulk editing. May cause lag if every layer is being edited. Can be disabled.</p>
</li>
<li><p>(experimental) Pressing SHIFT on an edit input will make the step by 10s instead of 1s, except for Scale inputs.</p>
</li>
</ul>
</div>
    </div>
    
    <div class="update-entry">
    <p class="update-date">10-05-2026</p>
    <div class="update-content"><p><strong>Viewer</strong></p>
<ul>
<li><p>Added the <strong>Miscellaneous</strong> list for all your minigame and other needs.</p>
<ul>
<li>This list probably won&#39;t be updated as much as the main lists.</li>
</ul>
</li>
</ul>
</div>
    </div>
    
    <div class="update-entry">
    <p class="update-date">10-03-2026</p>
    <div class="update-content"><p><strong>Gallery</strong></p>
<ul>
<li>Added download buttons to download individual image and whole gallery ordered in ZIP.</li>
</ul>
</div>
    </div>
    
    <div class="update-entry">
    <p class="update-date">10-02-2026</p>
    <div class="update-content"><p><strong>Jukebox</strong></p>
<ul>
<li><p>Added new curated albums.</p>
<ul>
<li><p><strong>TRANQUIL TALE</strong>: Calm tracks, not necessarily joyous.</p>
</li>
<li><p><strong>PRESSURE POINT</strong>: Tracks that create tension or suspense.</p>
</li>
</ul>
</li>
<li><p>TORN SOUL and FOREVER HALCYON has been sifted with a new criteria.</p>
<ul>
<li><p><strong>TORN SOUL</strong> should now contain the more somber tracks.</p>
</li>
<li><p><strong>FOREVER HALCYON</strong> should now contain the more upbeat tracks.</p>
</li>
</ul>
</li>
<li><p>Curated albums now show album covers instead of track numbers.</p>
</li>
<li><p>The theme of Ziz now plays properly with the intro.</p>
</li>
<li><p>The bug of Special Omurice not being able to play due to being misnamed has been fixed.</p>
</li>
</ul>
<p><strong>Nikkes</strong></p>
<ul>
<li><p>Added Rarity sort (with alphabetical subsort).</p>
</li>
<li><p>Sorting now should not affect search results.</p>
</li>
</ul>
</div>
    </div>
    
    <div class="update-entry">
    <p class="update-date">09-27-2026</p>
    <div class="update-content"><p><strong>Gallery</strong></p>
<ul>
<li><p>Added drag, pan, and zoom controls for Mobile and PC.</p>
<ul>
<li>You can reset by double-clicking or double-tapping.</li>
</ul>
</li>
<li><p>Removed swipe to change image on mobile.</p>
</li>
<li><p>Updated Main Story Chapter 40+ images that fixed continuity errors and height differences (rip big and tall Anis)</p>
</li>
</ul>
</div>
    </div>
    
    <div class="update-entry">
    <p class="update-date">09-20-2026</p>
    <div class="update-content"><p><strong>Battlefield Info</strong></p>
<p>The game had recently changed the names of the Elites to Exceeds. Why? No idea. The issues with stages not being opened should be fixed now.</p>
</div>
    </div>
    
    <div class="update-entry">
    <p class="update-date">09-19-2026</p>
    <div class="update-content"><p><strong>Nikkes</strong></p>
<ul>
<li><p>Added sorting.</p>
</li>
<li><p>Added the &quot;New on Top&quot; feature from Viewer.</p>
<ul>
<li>Nikkes with new skins have a red dot instead of the red N-dot.</li>
</ul>
</li>
<li><p>Search states now save per session.</p>
</li>
<li><p>Nikkes with skins unavailable for preview now are now inaccessible but still displayed (see <a href="/nikkes/label/">Label</a>)</p>
</li>
</ul>
<p><strong>Bestiary</strong></p>
<ul>
<li><p>Search states now save.</p>
<ul>
<li><p>Filters and queries are per tab.</p>
</li>
<li><p>&quot;New on Top&quot; and sort is persistent across tabs.</p>
</li>
</ul>
</li>
</ul>
</div>
    </div>
    
    <div class="update-entry">
    <p class="update-date">09-15-2026</p>
    <div class="update-content"><p><strong>General</strong></p>
<ul>
<li><p>Removed shilling on navbar, now in main page. Now includes NIKKE Font Generator.</p>
</li>
<li><p>Changed &quot;last updated&quot; to show your local time and days passed.</p>
</li>
</ul>
<p><strong>Viewer</strong></p>
<ul>
<li><p>Changed &quot;Screenshot&quot; to &quot;Download as PNG&quot;, as it was misleading people into thinking the background was included.</p>
<ul>
<li>Added additional text that confirms the fact that the background (and stars) are infact not included.</li>
</ul>
</li>
<li><p>UV Layer now takes the actual size of the image.</p>
<ul>
<li><em>What went over me designing it not like that before anyway???</em></li>
</ul>
</li>
</ul>
<p>If you&#39;re still wondering how to disable the stars, look for a star at the top of your screen.</p>
</div>
    </div>
    
    <div class="update-entry">
    <p class="update-date">09-13-2026</p>
    <div class="update-content"><p><strong>Jukebox</strong></p>
<ul>
<li><p>Added a visualizer. Click the magic wand icon next to the volume icon.</p>
<ul>
<li><p><strong>This produces <u>intense</u> strobing visuals that may trigger seizures for people with photosensitive epilepsy. Please only toggle if you can withstand viewing flashing lights and visuals.</strong></p>
</li>
<li><p>Click the visualizer to switch between presets.</p>
</li>
<li><p>Powered by <a href="https://butterchurnviz.com/">Butterchurn</a>.</p>
</li>
</ul>
</li>
</ul>
</div>
    </div>
    
    <div class="update-entry">
    <p class="update-date">09-04-2026</p>
    <div class="update-content"><p><strong>Nikkes</strong></p>
<ul>
<li>Added squad affiliations.</li>
</ul>
</div>
    </div>
    
    <div class="update-entry">
    <p class="update-date">08-29-2026</p>
    <div class="update-content"><p><strong>Jukebox</strong></p>
<ul>
<li>Added track search.</li>
</ul>
<p><strong>General</strong></p>
<ul>
<li>Fixed keybinds being persistent across pages, causing some default functions to stop working (e.g. going from Jukebox to Feedback makes the spacebar stop working).</li>
</ul>
</div>
    </div>
    
    <div class="update-entry">
    <p class="update-date">08-26-2026</p>
    <div class="update-content"><p><strong>Jukebox</strong></p>
<ul>
<li><p>Fixed the curated album TORN SOUL having tracks meant for ENCOUNTER.</p>
</li>
<li><p>Fixed the seekbar not being quite a seekbar on mobile.</p>
</li>
</ul>
<p><strong>Viewer</strong></p>
<ul>
<li>Fixed background not being set properly when changed.</li>
</ul>
</div>
    </div>
    
    <div class="update-entry">
    <p class="update-date">08-25-2026</p>
    <div class="update-content"><h2>The Ultimate Redo</h2>
<p><em>date fixed</em></p>
<p>The site has been slightly tweaked to look and feel better. You may also notice that the site is now incredibly green.</p>
<p>Also added new stuff!</p>
<ul>
<li><p><a href="/nikkes/"><strong>Nikkes</strong></a>: You can now view Nikke information and advise sessions directly through NKAS.</p>
</li>
<li><p><a href="/advise/"><strong>Advises</strong></a>: Easily search for advise answers!</p>
</li>
</ul>
<p>Fixes!</p>
<ul>
<li><p><a href="/viewer/"><strong>Viewer</strong></a>: Zooming with pinching/spreading on mobile is now much more uniform.</p>
</li>
<li><p><a href="/gallery/"><strong>Gallery</strong></a>: Essentially much more polished now.</p>
</li>
<li><p><a href="/bestiary/"><strong>Bestiary</strong></a>:</p>
<ul>
<li><p>Now spelt correctly.</p>
</li>
<li><p><strong>3D PREVIEWS</strong>! Of course, some Raptures still look bugged visual-wise, but is a big feature! You can tilt and move them around to inspect them.</p>
<ul>
<li>If you&#39;d like a &quot;Rapture Viewer&quot; of some sort, toss it over to <a href="/feedback/">feedback</a>!</li>
</ul>
</li>
<li><p>Data related to this page <em>will still be served under</em> <code>beastiary</code>.</p>
</li>
<li><p><a href="https://nkas.pages.dev/beastiary/">https://nkas.pages.dev/beastiary/</a> now automatically redirects to <code>/bestiary/</code>.</p>
</li>
</ul>
</li>
<li><p><a href="/jukebox/"><strong>Jukebox</strong></a>:</p>
<ul>
<li><p>Remade from the ground up.</p>
</li>
<li><p>Composer credits are now in the main page, with each composer being their own album.</p>
</li>
<li><p>Tracks played in Curated Albums will now take form of their actual album.</p>
</li>
<li><p>Added volume slider.</p>
</li>
<li><p>Added the ability to directly download tracks and whole albums.</p>
</li>
<li><p>Improved interface by like tenfold.</p>
</li>
<li><p>Improved transitions for songs that are split with intro + looping tracks.</p>
</li>
<li><p>Improved transitions when playing the next song.</p>
</li>
</ul>
</li>
<li><p><a href="/jukebox/"><strong>Battlefield Info</strong></a>:</p>
<ul>
<li><p>Added Tower stages.</p>
</li>
<li><p>Added Rapture stats.</p>
</li>
<li><p>Improved interface.</p>
</li>
</ul>
</li>
</ul>
<p>This entire update may be buggy. As always, report issues ASAP in <a href="https://github.com/skuqre/nkas-issues/issues/new/choose/">nkas-issues</a> or in <a href="/feedback/">Feedback</a>.</p>
<p>Thank you for visiting NKAS!</p>
</div>
    </div>
    
