</script><script>(function(){const buildDate = "2026-10-13T18:13:31.620Z";

            async function theEntireScript() {
                if (!document.getElementById("build-date")) return;
                const build = new Date(buildDate);

                const dateTime = build.toLocaleString(undefined, {
                    dateStyle: "medium",
                    timeStyle: "short"
                });

                const timeZone = new Intl.DateTimeFormat(undefined, {
                    timeZoneName: "short"
                }).formatToParts(build).find(p => p.type === "timeZoneName")?.value ?? "";

                const now = new Date();
                const msPerDay = 1000 * 60 * 60 * 24;
                const startOfBuild = new Date(build.getFullYear(), build.getMonth(), build.getDate());
                const startOfNow = new Date(now.getFullYear(), now.getMonth(), now.getDate());
                const daysElapsed = Math.round((startOfNow - startOfBuild) / msPerDay);

                const rtf = new Intl.RelativeTimeFormat(undefined, { numeric: "auto" });
                const relativeDays = rtf.format(-daysElapsed, "day");
                document.getElementById("build-date").textContent = `${dateTime} ${timeZone} (${relativeDays})`;
            }

            document.addEventListener("astro:page-load", theEntireScript);
        })();</script><!-- Cloudflare Pages Analytics --><script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "74fd259ebc1e474a90627ee53d0dafbb"}'></script><!-- Cloudflare Pages Analytics --></body></html>