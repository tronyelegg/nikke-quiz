<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=0.75"><meta name="google-site-verification" content="Gu1EbIytnh1sdrGXl_TxX4mFH4xb_FpGC_SmNF5JOWU"><meta name="astro-view-transitions-enabled" content="true"><meta name="astro-view-transitions-fallback" content="animate"><script type="text/javascript" nonce="014110eece6e4d72b8d1aa95091" src="//local.adguard.org?ts=1792124845745&amp;type=content-script&amp;dmn=nkas.pages.dev&amp;url=https%3A%2F%2Fnkas.pages.dev%2Fcharacters%2Fsi_c945_00_s.png&amp;app=chrome.exe&amp;css=3&amp;js=1&amp;rel=1&amp;rji=1&amp;sbe=1"></script><script type="text/javascript" nonce="014110eece6e4d72b8d1aa95091" src="//local.adguard.org?ts=1792124845745&amp;name=AdGuard%20Extra&amp;name=AdGuard%20Popup%20Blocker&amp;type=user-script"></script><script type="module" src="/_astro/ClientRouter.astro_astro_type_script_index_0_lang.Db2zAGoj.js"></script><title>NKAS</title><meta name="description" content="A companion website for most of your butt game needs. Inspect character details, stage information, Rapture information, listen to the OST, and more."><link rel="icon" href="/favicon.ico"><meta name="theme-color" content="#00ff86"><meta name="robots" content="index, follow"><meta property="og:url" content="https://nkas.pages.dev/"><meta property="og:type" content="website"><meta property="og:title" content="NKAS"><meta property="og:description" content="A companion website for most of your butt game needs. Inspect character details, stage information, Rapture information, listen to the OST, and more."><meta property="og:image" content="https://nkas.pages.dev/default-og.png"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="NKAS"><meta name="twitter:description" content="A companion website for most of your butt game needs. Inspect character details, stage information, Rapture information, listen to the OST, and more."><meta name="twitter:image" content="https://nkas.pages.dev/default-og.png"><link rel="canonical" href="https://nkas.pages.dev/"><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"NKAS","description":"A companion website for most of your butt game needs. Inspect character details, stage information, Rapture information, listen to the OST, and more.","url":"https://nkas.pages.dev/"}</script><link rel="icon" type="image/png" href="/common/nkas.png"><link rel="icon" href="/favicon.ico" sizes="any"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA==" crossorigin="anonymous" referrerpolicy="no-referrer"><link rel="stylesheet" href="/_astro/Footer.DQh_KV0k.css"><style>div[data-astro-cid-akds2wd5].info-card {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  padding: 16px;
  box-sizing: border-box;
  border-left-width: 3px;
  text-align: left;
  font-size: 14px;
  gap: 16px;
}

div[data-astro-cid-akds2wd5].info-card i[data-astro-cid-akds2wd5] {
  font-size: 20px;
}

div[data-astro-cid-akds2wd5].info-card span[data-astro-cid-akds2wd5] {
